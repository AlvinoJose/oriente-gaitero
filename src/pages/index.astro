      <img
        src="/media/photo.svg"
        alt="Oriente Gaitero sobre el escenario"
        width="1200"
        height="750"
        loading="lazy"
        decoding="async"
        class="aspect-[16/10] w-full rounded-3xl border border-white/10 object-cover"
      />


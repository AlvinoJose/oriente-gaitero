                <Icon name={pillar.icon} class="h-7 w-7" />
              </span>
              <span class="text-xs font-medium leading-tight text-white/80 sm:text-sm">
                {pillar.label}
              </span>
            </li>
          ))
        }
      </ul>

      <div class="mt-9">
        <SecondaryButton href="/nosotros">
          <Icon name="arrow" class="h-4 w-4" />
          Conoce más
        </SecondaryButton>
      </div>
    </div>

    <img
      src="/media/brush.svg"
      alt=""
      aria-hidden="true"
      class="pointer-events-none absolute inset-x-0 bottom-0 h-16 w-full object-fill opacity-90 sm:h-24"
    />
  </section> -->

  <!-- Tipos de evento -->
  <section class="border-b border-white/10">
    <div class="mx-auto max-w-6xl px-4 py-14 sm:px-6 lg:px-8 lg:py-20">
      <SectionHeading
        eyebrow="Tipos de evento"
        title="¿QUÉ ESTÁS ORGANIZANDO?"
        subtitle="Elige el tipo de evento y llevas el formato ya cargado al formulario de contacto."
      />
      <ul class="mt-8 grid grid-cols-2 gap-3 sm:gap-4 lg:grid-cols-4">
        {
          homeEvents.map((event) => (
            <li>
              <EventCard
                id={event.id}
                label={event.label}
                description={event.description}
                image={event.image}
              />
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- Propuesta de valor -->
  <section class="border-b border-white/10 bg-carbon-soft">
    <div class="mx-auto max-w-6xl px-4 py-14 sm:px-6 lg:px-8 lg:py-20">
      <SectionHeading eyebrow="Propuesta" title="MÚSICA QUE CONECTA" />
      <ul class="mt-8 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
        {
          values.map((value, index) => (
            <li>
              <ValueCard index={index + 1} title={value.title} text={value.text} />
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- Galería -->
  <!-- <section class="border-b border-white/10">
    <div class="mx-auto max-w-6xl px-4 py-14 sm:px-6 lg:px-8 lg:py-20">
      <div class="flex flex-wrap items-end justify-between gap-4">
        <SectionHeading eyebrow="Portafolio" title="GALERÍA" />
        <SecondaryButton href="/galeria" size="sm">Ver toda la galería</SecondaryButton>
      </div>
      <div class="mt-8">
        <GalleryGrid limit={8} />
      </div>
    </div>
  </section> -->

  <!-- Redes -->
  <section class="border-b border-white/10">
    <div class="mx-auto flex max-w-6xl flex-col items-center gap-6 px-4 py-12 text-center sm:px-6 lg:px-8">
      <SectionHeading eyebrow="Síguenos" title="ORIENTE GAITERO EN REDES" />
      <SocialLinks />
    </div>
  </section>

  <!-- Testimonios -->
  <!-- <section class="border-b border-white/10">
    <div class="mx-auto max-w-6xl px-4 py-14 sm:px-6 lg:px-8 lg:py-20">
      <SectionHeading
        eyebrow="Testimonios"
        title="LO QUE DICEN DE NOSOTROS"
        subtitle="Solo publicamos testimonios reales y autorizados."
      />
      <ul class="mt-8 grid gap-4 md:grid-cols-2">
        {
          testimonials.items.map((item) => (
            <li>
              <TestimonialCard
                quote={item.quote}
                author={item.author}
                role={item.role}
                pending={isPending(item.quote) || isPending(item.author)}
              />
            </li>
          ))
        }
      </ul>
    </div>
  </section> -->

  <!-- CTA -->
  <section class="relative overflow-hidden border-b border-white/10 bg-naranja text-carbon">
    <div class="mx-auto flex max-w-6xl flex-col items-start gap-6 px-4 pb-24 pt-14 sm:px-6 lg:flex-row lg:items-center lg:justify-between lg:px-8 lg:pb-28 lg:pt-16">
      <div>
        <p class="text-xs font-semibold uppercase tracking-widest text-carbon/70">Contratación</p>
        <h2 class="mt-3 text-3xl leading-tight sm:text-4xl">¿TIENES UN EVENTO?</h2>
        <p class="mt-3 max-w-lg text-carbon/80">
          Cuéntanos la fecha, el lugar y el tipo de celebración. Te respondemos con una propuesta.
        </p>
      </div>
      <div class="flex flex-wrap gap-3">
        <a
          href="/contacto"
          class="inline-flex min-h-12 items-center justify-center gap-2 rounded-full bg-carbon px-6 text-sm font-bold uppercase tracking-wider text-white transition hover:bg-carbon-soft active:scale-[0.98]"
        >
          Solicitar cotización
        </a>
        <a
          href="/show"
          class="inline-flex min-h-12 items-center justify-center gap-2 rounded-full border border-carbon/40 px-6 text-sm font-bold uppercase tracking-wider text-carbon transition hover:border-carbon hover:bg-carbon/10"
        >
          Ver show
        </a>
      </div>
    </div>
    <img
      src="/media/brush.svg"
      alt=""
      aria-hidden="true"
      class="pointer-events-none absolute inset-x-0 bottom-0 h-16 w-full object-fill opacity-40 sm:h-24"
    />
  </section>

  <!-- FAQ -->
  <section class="border-b border-white/10">
    <div class="mx-auto max-w-6xl px-4 py-14 sm:px-6 lg:px-8 lg:py-20">
      <SectionHeading eyebrow="Preguntas" title="PREGUNTAS FRECUENTES" />
      <div class="mt-8 divide-y divide-white/10 border-y border-white/10">
        {
          faq.items.map((item) => (
            <details class="group py-4">
              <summary class="flex cursor-pointer list-none items-center justify-between gap-4 text-base font-medium text-white">
                {item.question}
                <span
                  class="flex h-8 w-8 shrink-0 items-center justify-center rounded-full border border-white/20 text-white/70 transition group-open:-rotate-180"
                  aria-hidden="true"
                >
                  <Icon name="chevron" class="h-5 w-5" />
                </span>
              </summary>
              <p class="mt-3 pr-12 text-sm leading-relaxed text-white/60">{item.answer}</p>
            </details>
          ))
        }
      </div>

      <div class="mt-10 flex flex-wrap gap-3">
        <PrimaryButton href="/contacto">Contratar</PrimaryButton>
        <SecondaryButton href="/nosotros">Conócenos</SecondaryButton>
      </div>
    </div>
  </section>
</BaseLayout>

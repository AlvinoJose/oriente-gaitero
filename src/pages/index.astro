  { label: 'Privados', icon: 'users', href: '/contacto?tipo=privados' },
  { label: 'Navidad', icon: 'star', href: '/contacto?tipo=navidad' },
  { label: 'Festivales', icon: 'music', href: '/contacto?tipo=festivales' },
];

const featuredEvents = ['privados', 'corporativos', 'festivales', 'navidad'];
const homeEvents = events.filter((event) => featuredEvents.includes(event.id));
const isPending = (value: string) => value.includes('[PENDIENTE]');

// TODO (spec UI/UX v2 §2.1): cuando exista el video de 10-15 s, asignar '/media/hero.mp4'
const heroVideoSrc = '/media/hero.mp4';


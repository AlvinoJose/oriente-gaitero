---
import BaseLayout from '../layouts/BaseLayout.astro';
import VideoHero from '../components/VideoHero.astro';
import SectionHeading from '../components/SectionHeading.astro';
import EventCard from '../components/EventCard.astro';
import ValueCard from '../components/ValueCard.astro';
import GalleryGrid from '../components/GalleryGrid.astro';
import TestimonialCard from '../components/TestimonialCard.astro';
import PrimaryButton from '../components/PrimaryButton.astro';
import SecondaryButton from '../components/SecondaryButton.astro';
import SocialLinks from '../components/SocialLinks.astro';
import Icon from '../components/Icon.astro';
import { emailUrl, isPlaceholder, whatsappUrl } from '../lib/contact';

import site from '../data/site.config.json';
import about from '../data/about.json';
import show from '../data/show.json';
import events from '../data/events.json';
import values from '../data/values.json';
import testimonials from '../data/testimonials.json';
import faq from '../data/faq.json';

const heroCategories = [
  { label: 'Corporativos', icon: 'briefcase', href: '/contacto?tipo=corporativos' },
  { label: 'Privados', icon: 'users', href: '/contacto?tipo=privados' },
  { label: 'Navidad', icon: 'star', href: '/contacto?tipo=navidad' },
  { label: 'Festivales', icon: 'music', href: '/contacto?tipo=festivales' },
];

const featuredEvents = ['privados', 'corporativos', 'festivales', 'navidad'];
const homeEvents = events.filter((event) => featuredEvents.includes(event.id));
const isPending = (value: string) => value.includes('[PENDIENTE]');
---

<BaseLayout
  title="Oriente Gaitero | Gaita Zuliana para Eventos"
  description="Oriente Gaitero — agrupación de gaita zuliana para eventos privados, corporativos, festivales y celebraciones."
  fullBleed
>
  <!-- Hero (prototipo 1) -->
  <section class="relative overflow-hidden">
    <img
      src="/media/hero.svg"
      alt="Oriente Gaitero en plena presentación"
      width="900"
      height="1200"
      fetchpriority="high"
      decoding="async"
      class="absolute inset-0 h-full w-full object-cover"
    />
    <div
      class="absolute inset-0 bg-gradient-to-b from-carbon/85 via-carbon/40 to-carbon"
      aria-hidden="true"
    ></div>
    <img
      src="/media/brush.svg"
      alt=""
      aria-hidden="true"
      class="pointer-events-none absolute inset-x-0 bottom-0 h-20 w-full object-fill opacity-90 sm:h-28"
    />

    <div
      class="relative mx-auto flex min-h-[92svh] max-w-6xl flex-col justify-end gap-7 px-4 pb-16 pt-28 sm:px-6 lg:px-8 lg:pb-20"
    >
      <h1 class="font-display text-4xl italic leading-[1.02] sm:text-4xl lg:text-5xl">
        <span class="block text-white">GAITA ZULIANA</span>
        <span class="block text-naranja">CON IDENTIDAD, ENERGÍA</span>
        <span class="block text-white">Y ESPECTÁCULO</span>
      </h1>

      <ul class="grid grid-cols-4 gap-1.5">
        {
          heroCategories.map((category) => (
            <li>
              <a
                href={category.href}
                class="flex h-full flex-col items-center justify-start gap-1.5 rounded-xl border border-white/10 bg-carbon/40 px-1 py-2.5 text-center backdrop-blur-sm transition hover:border-naranja hover:bg-carbon/70 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-turquesa-soft"
              >
                <span class="flex h-9 w-9 items-center justify-center rounded-lg border-t-2 border-naranja bg-carbon/70 text-white">
                  <Icon name={category.icon} class="h-5 w-5" />
                </span>
                <span class="text-[9px] font-semibold uppercase leading-[1.15] tracking-tight text-white/80 [word-break:break-word]">
                  {category.label}
                </span>
              </a>
            </li>
          ))
        }
      </ul>

      <div class="flex justify-center w-full flex-col gap-3 sm:max-w-sm">
        <PrimaryButton href="/contacto" class="w-full">
          <Icon name="calendar" class="h-5 w-5" />
          Contratar
        </PrimaryButton>

        <a
          href="/show"
          class="inline-flex min-h-12 w-full items-center justify-center gap-2 rounded-full bg-white px-6 text-sm font-bold uppercase tracking-wider text-carbon transition hover:bg-white/90 active:scale-[0.98]"
        >
          <span class="flex h-6 w-6 items-center justify-center rounded-full bg-naranja text-carbon">
            <Icon name="play" class="ml-0.5 h-4 w-4" />
          </span>
          Ver show
        </a>

        <a
          href={whatsappUrl()}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex min-h-12 w-full items-center justify-center gap-2 rounded-full border border-white/30 bg-turquesa px-6 text-sm font-bold uppercase tracking-wider text-white backdrop-blur-sm transition hover:border-white hover:bg-turquesa-soft active:scale-[0.98]"
        >
            <Icon name="whatsapp" class="h-5 w-5" />
            Escribir por WhatsApp
          </a>
      </div>
    </div>
  </section>

    <!-- El Show (prototipo 3) -->

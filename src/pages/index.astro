<script>
  import { contactIntentUrl } from '../lib/vcard';

  const heroVideo = document.querySelector<HTMLVideoElement>('[data-hero-video]');
  const heroSrc = heroVideo?.dataset.heroVideo;

  if (heroVideo && heroSrc) {
    const start = () => {
      heroVideo.src = heroSrc;
      void heroVideo.play().catch(() => undefined);
    };
    if (typeof window.requestIdleCallback === 'function') window.requestIdleCallback(start);
    else window.setTimeout(start, 800);
  }

  // Guardar contacto: en Android abre la app de Contactos (intent), en iOS la tarjeta .vcf
  const saveContact = document.querySelector<HTMLAnchorElement>('[data-save-contact]');

  saveContact?.addEventListener('click', (event) => {
    const ua = navigator.userAgent;
    const isAndroid = /Android/.test(ua) && !/Firefox/.test(ua);
    const isIOS =
      /iPhone|iPad|iPod/.test(ua) ||
      (navigator.maxTouchPoints > 1 && /MacIntel/.test(navigator.platform));

    if (isAndroid) {
      // El intent se arma en el dispositivo para que el fallback use el dominio real
      event.preventDefault();
      window.location.href = contactIntentUrl(window.location.origin);
      return;
    }

    if (isIOS) {
      event.preventDefault();
      window.open(saveContact.href, '_blank', 'noopener');
    }
  });
</script>

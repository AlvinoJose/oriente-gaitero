    <img
      src="/media/brush.svg"
      alt=""
      aria-hidden="true"
      class="pointer-events-none absolute inset-x-0 bottom-0 h-16 w-full object-fill opacity-90 sm:h-24"
    />
  </section> -->

  <div id="video" class="scroll-mt-16">
    <VideoHero />
  </div>

  <!-- ¿Quiénes somos? (prototipo 2) -->
  <!-- <section class="relative overflow-hidden border-b border-white/10">
    <div class="mx-auto max-w-6xl px-4 pb-24 pt-14 sm:px-6 lg:px-8 lg:pb-28 lg:pt-20">
      <img
        src="/media/photo.svg"
        alt="La agrupación al atardecer"
        width="1200"
        height="750"
        loading="lazy"
        decoding="async"
        class="aspect-[16/10] w-full rounded-3xl border border-white/10 object-cover"
      />

      <h2 class="mt-8 text-3xl leading-tight sm:text-4xl">¿Quiénes somos?</h2>
      <p class="mt-3 text-lg font-semibold text-naranja">{about.headline}</p>
      <p class="mt-4 max-w-2xl leading-relaxed text-white/70">{about.intro}</p>


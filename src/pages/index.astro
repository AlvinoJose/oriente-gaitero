                <Icon name={feature.icon} class="h-5 w-5" />
              </span>
              <span class="text-sm text-white/85 sm:text-base">{feature.label}</span>
            </li>
          ))
        }
      </ul>

      <div class="mt-8">
        <a
          href="#video"
          class="inline-flex min-h-12 items-center justify-center gap-2 rounded-full bg-white px-6 text-sm font-bold uppercase tracking-wider text-carbon transition hover:bg-white/90 active:scale-[0.98]"
        >

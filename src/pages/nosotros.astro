---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import SectionHeading from '../components/SectionHeading.astro';
import PrimaryButton from '../components/PrimaryButton.astro';
import SecondaryButton from '../components/SecondaryButton.astro';

import about from '../data/about.json';
import team from '../data/team.json';

const blocks = [
  { label: 'Historia', text: about.history },
  { label: 'Propósito', text: about.purpose },
  { label: 'Visión', text: about.vision },
];
---

<BaseLayout
  title="Nosotros | Oriente Gaitero"
  description="Tres amigos, una pasión y una visión: la historia de Oriente Gaitero."
>
  <PageHero eyebrow="Nosotros" title={about.headline} />

  <section>
    <div class="mx-auto max-w-6xl px-4 py-14 sm:px-6 lg:px-8 lg:py-20">
      <ul class="grid gap-6 md:grid-cols-3">
        {
          blocks.map((block) => (
            <li class="rounded-2xl border border-white/10 bg-white/[0.03] p-6">
              <h2 class="text-sm font-semibold uppercase tracking-widest text-turquesa">
                {block.label}
              </h2>
              <p class="mt-3 text-sm leading-relaxed text-white/70">{block.text}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  {
    team.authorized && (
      <section class="border-y border-white/10 bg-carbon-soft">
        <div class="mx-auto max-w-6xl px-4 py-14 sm:px-6 lg:px-8 lg:py-20">
          <SectionHeading eyebrow="Integrantes" title="QUIÉNES TOCAN" />
          <ul class="mt-8 grid gap-4 sm:grid-cols-3">
            {team.members.map((member) => (
              <li class="rounded-2xl border border-white/10 bg-white/[0.03] p-6 text-center">
                <p class="font-display text-lg text-white">{member.name}</p>
                <p class="mt-1 text-sm text-white/50">{member.role}</p>
              </li>
            ))}
          </ul>
        </div>
      </section>
    )
  }

  <section class="border-t border-white/10">
    <div class="mx-auto flex max-w-6xl flex-col gap-6 px-4 py-14 sm:px-6 lg:px-8 lg:py-20">
      <SectionHeading
        eyebrow="Trabaja con nosotros"
        title="¿ORGANIZAS UN EVENTO?"
        subtitle="Cuéntanos qué tienes en mente y armamos el formato adecuado."
      />
      <div class="flex flex-wrap gap-3">
        <PrimaryButton href="/contacto">Contratar</PrimaryButton>
        <SecondaryButton href="/show">Ver show</SecondaryButton>
      </div>
    </div>
  </section>
</BaseLayout>

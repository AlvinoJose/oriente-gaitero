---
import Icon from './Icon.astro';
---

<dialog
  data-lightbox
  aria-label="Vista ampliada de fotografía"
  class="m-0 h-dvh max-h-none w-full max-w-none border-0 bg-carbon/95 p-0 text-white backdrop:bg-black/90"
>
  <div class="flex h-full flex-col">
    <div class="flex items-center justify-between gap-4 p-3">
      <p data-lightbox-counter class="text-xs font-semibold uppercase tracking-wider text-white/60">
      </p>
      <button
        type="button"
        data-lightbox-close
        class="flex h-11 w-11 items-center justify-center rounded-full text-white transition hover:bg-white/10"
      >
        <span class="sr-only">Cerrar galería</span>
        <Icon name="close" class="h-6 w-6" />
      </button>
    </div>

    <div class="flex flex-1 items-center justify-center overflow-hidden px-4">
      <img
        data-lightbox-img
        src=""
        alt=""
        class="max-h-full max-w-full rounded-xl object-contain"
      />
    </div>

    <div class="flex items-center justify-center gap-6 p-5">
      <button
        type="button"
        data-lightbox-prev
        class="flex h-12 w-12 items-center justify-center rounded-full border border-white/20 text-white transition hover:border-naranja hover:text-naranja"
      >
        <span class="sr-only">Fotografía anterior</span>
        <Icon name="arrow" class="h-6 w-6 rotate-180" />
      </button>
      <button
        type="button"
        data-lightbox-next
        class="flex h-12 w-12 items-center justify-center rounded-full border border-white/20 text-white transition hover:border-naranja hover:text-naranja"
      >
        <span class="sr-only">Fotografía siguiente</span>
        <Icon name="arrow" class="h-6 w-6" />
      </button>
    </div>
  </div>
</dialog>

<script>
  const dialog = document.querySelector<HTMLDialogElement>('[data-lightbox]');
  const image = dialog?.querySelector<HTMLImageElement>('[data-lightbox-img]');
  const counter = dialog?.querySelector<HTMLElement>('[data-lightbox-counter]');

  const all = () => Array.from(document.querySelectorAll<HTMLButtonElement>('[data-lightbox-item]'));
  const visible = () => all().filter((item) => !item.closest('li')?.hidden);

  if (dialog && image) {
    let list: HTMLButtonElement[] = [];
    let current = 0;

    const render = () => {
      const item = list[current];
      if (!item) return;
      image.src = item.dataset.src ?? '';
      image.alt = item.dataset.alt ?? '';
      if (counter) counter.textContent = `${current + 1} / ${list.length}`;
    };

    const step = (delta: number) => {
      if (list.length === 0) list = visible();
      current = (current + delta + list.length) % list.length;
      render();
    };

    all().forEach((item) => {
      item.addEventListener('click', () => {
        list = visible();
        current = Math.max(0, list.indexOf(item));
        render();
        if (!dialog.open) dialog.showModal();
      });
    });

    dialog.querySelector('[data-lightbox-close]')?.addEventListener('click', () => dialog.close());
    dialog.querySelector('[data-lightbox-prev]')?.addEventListener('click', () => step(-1));
    dialog.querySelector('[data-lightbox-next]')?.addEventListener('click', () => step(1));

    dialog.addEventListener('keydown', (event) => {
      if (event.key === 'ArrowLeft') step(-1);
      if (event.key === 'ArrowRight') step(1);
    });

    dialog.addEventListener('click', (event) => {
      if (event.target === dialog) dialog.close();
    });
  }
</script>

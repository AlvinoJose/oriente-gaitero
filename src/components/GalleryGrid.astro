---
import Lightbox from './Lightbox.astro';
import gallery from '../data/gallery.json';

interface Props {
  limit?: number;
  filterable?: boolean;
}

const { limit, filterable = false } = Astro.props;
const items = typeof limit === 'number' ? gallery.items.slice(0, limit) : gallery.items;
const categories = [...new Set(gallery.items.map((item) => item.category))];
---

{
  filterable && (
    <div role="group" aria-label="Filtrar por categoría" class="mb-6 flex flex-wrap gap-2">
      <button type="button" data-filter="" aria-pressed="true" class="gallery-filter">
        Todas
      </button>
      {categories.map((category) => (
        <button type="button" data-filter={category} aria-pressed="false" class="gallery-filter">
          {category}
        </button>
      ))}
    </div>
  )
}

<ul class="grid grid-cols-2 gap-3 sm:gap-4 lg:grid-cols-4">
  {
    items.map((item) => (
      <li data-category={item.category}>
        <button
          type="button"
          data-lightbox-item
          data-src={item.src}
          data-alt={item.alt}
          class="group relative block aspect-square w-full overflow-hidden rounded-2xl border border-white/10 bg-carbon-soft focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-turquesa-soft"
        >
          <img
            src={item.src}
            alt={item.alt}
            width="800"
            height="800"
            loading="lazy"
            decoding="async"
            class="h-full w-full object-cover transition duration-300 group-hover:scale-105"
          />
          <span class="absolute right-2 top-2 rounded-full bg-carbon/70 px-2 py-1 text-[10px] font-semibold uppercase tracking-wider text-white/80">
            {item.category}
          </span>
        </button>
      </li>
    ))
  }
</ul>

<Lightbox />

<script>
  const buttons = Array.from(document.querySelectorAll<HTMLButtonElement>('[data-filter]'));
  const cells = Array.from(document.querySelectorAll<HTMLElement>('[data-category]'));

  const apply = (filter: string) => {
    buttons.forEach((button) => {
      button.setAttribute('aria-pressed', String(button.dataset.filter === filter));
    });
    cells.forEach((cell) => {
      cell.hidden = filter !== '' && cell.dataset.category !== filter;
    });
  };

  buttons.forEach((button) => {
    button.addEventListener('click', () => apply(button.dataset.filter ?? ''));
  });
</script>

---
import Logo from './Logo.astro';
import SocialLinks from './SocialLinks.astro';
import site from '../data/site.config.json';
import nav from '../data/nav.json';
import profile from '../data/profile.json';
import { emailUrl, isPlaceholder, whatsappSecondaryUrl, whatsappUrl } from '../lib/contact';

const year = new Date().getFullYear();
const secondaryWhatsapp = whatsappSecondaryUrl();
const showEmail = !isPlaceholder(site.email);
const showCity = !isPlaceholder(site.city);
const showHours = !isPlaceholder(site.hours);
---

<footer class="border-t border-white/10 bg-carbon-soft">
  <div class="mx-auto max-w-6xl px-4 py-12 sm:px-6 lg:px-8">
    <div class="grid gap-10 sm:grid-cols-2 lg:grid-cols-3">
      <div>
        <a href="/" aria-label="Oriente Gaitero — Inicio">
          <Logo class="text-xl" />
        </a>
        <p class="mt-3 max-w-xs text-sm leading-relaxed text-white/60">{profile.tagline}</p>
      </div>

      <nav aria-label="Navegación del pie">
        <h2 class="text-xs font-semibold uppercase tracking-widest text-turquesa">Navegación</h2>
        <ul class="mt-4 flex flex-col gap-2">
          {
            nav.map((item) => (
              <li>
                <a href={item.href} class="text-sm text-white/70 transition hover:text-white">
                  {item.label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>

      <div>
        <h2 class="text-xs font-semibold uppercase tracking-widest text-turquesa">Contacto</h2>
        <ul class="mt-4 flex flex-col gap-2 text-sm text-white/70">
          <li>
            <a
              href={whatsappUrl()}
              target="_blank"
              rel="noopener noreferrer"
              class="transition hover:text-white"
            >
              WhatsApp: +{site.whatsapp.number}
              {
                site.whatsapp.numberPending && (
                  <span class="ml-1 rounded bg-naranja/20 px-1.5 py-0.5 text-[10px] font-semibold uppercase text-naranja-soft">
                    pendiente
                  </span>
                )
              }
            </a>
          </li>
          {
            secondaryWhatsapp && (
              <li>
                <a
                  href={secondaryWhatsapp}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="transition hover:text-white"
                >
                  WhatsApp secundario: +{site.whatsapp.numberSecondary}
                </a>
              </li>
            )
          }
          {
            showEmail && (
              <li>
                <a href={emailUrl()} class="transition hover:text-white">
                  {site.email}
                </a>
              </li>
            )
          }
          {showCity && <li>{site.city}</li>}
          {showHours && <li>{site.hours}</li>}
        </ul>
      </div>

      <!-- <div>
        <h2 class="text-xs font-semibold uppercase tracking-widest text-turquesa">Contratar</h2>
        <p class="mt-4 text-sm text-white/60">
          Cuéntanos qué estás organizando y te respondemos con una propuesta.
        </p>
        <a
          href={whatsappUrl()}
          target="_blank"
          rel="noopener noreferrer"
          class="mt-4 inline-flex min-h-11 items-center justify-center rounded-full bg-naranja px-5 text-xs font-bold uppercase tracking-wider text-carbon transition hover:bg-naranja-soft"
        >
          Escribir por WhatsApp
        </a>
      </div> -->
    </div>

    <!-- <div class="mt-10 border-t border-white/10 pt-6">
      <h2 class="text-xs font-semibold uppercase tracking-widest text-turquesa">Síguenos</h2>
      <div class="mt-4">
        <SocialLinks />
      </div>
    </div> -->

    <div
      class="mt-6 flex flex-col gap-3 text-xs text-white/40 sm:flex-row sm:items-center sm:justify-between"
    >
      <p>© {year} {site.copyright}. Todos los derechos reservados.</p>
      <!-- <p class="flex gap-4">
        <a href={site.privacyUrl} class="transition hover:text-white">Privacidad</a>
        <a href={site.termsUrl} class="transition hover:text-white">Términos</a>
      </p> -->
    </div>
  </div>
</footer>

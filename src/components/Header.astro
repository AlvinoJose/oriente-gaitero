---
import Logo from './Logo.astro';
import Icon from './Icon.astro';
import MobileMenu from './MobileMenu.astro';
import PrimaryButton from './PrimaryButton.astro';
import nav from '../data/nav.json';

const current = Astro.url.pathname.replace(/\/$/, '') || '/';
---

<header
  data-header
  class="fixed inset-x-0 top-0 z-50 border-b border-transparent"
>
  <div class="mx-auto flex h-16 max-w-6xl items-center justify-between gap-4 px-4 sm:px-6">
    <a href="/" aria-label="Oriente Gaitero — Inicio" class="shrink-0">
      <Logo class="text-lg" />
    </a>

    <nav aria-label="Navegación principal" class="hidden items-center gap-1 lg:flex">
      {
        nav.map((item) => (
          <a
            href={item.href}
            aria-current={item.href === current ? 'page' : undefined}
            class:list={[
              'rounded-full px-4 py-2 text-sm font-medium transition hover:bg-white/10 hover:text-white',
              item.href === current ? 'bg-white/10 text-white' : 'text-white/70',
            ]}
          >
            {item.label}
          </a>
        ))
      }
    </nav>

    <div class="flex items-center gap-2">
      <!-- <span class="hidden sm:block">
        <PrimaryButton href="/contacto" size="sm">Contratar</PrimaryButton>
      </span> -->
      <button
        type="button"
        data-menu-open
        aria-expanded="false"
        aria-controls="mobile-menu"
        class="flex h-11 w-11 items-center justify-center rounded-full text-white transition hover:bg-white/10 lg:hidden"
      >
        <span class="sr-only">Abrir menú</span>
        <Icon name="menu" class="h-6 w-6" />
      </button>
    </div>
  </div>
</header>

<MobileMenu items={nav} current={current} />

<script>
  const header = document.querySelector<HTMLElement>('[data-header]');

  const update = () => header?.classList.toggle('header-compact', window.scrollY > 50);

  update();
  window.addEventListener('scroll', update, { passive: true });
</script>

---
import Icon from './Icon.astro';
import { whatsappUrl } from '../lib/contact';
---

<a
  href={whatsappUrl()}
  target="_blank"
  rel="noopener noreferrer"
  class="fixed inset-x-0 bottom-0 z-40 flex h-14 items-center justify-center gap-2 border-t border-naranja/40 bg-carbon/80 text-sm font-bold uppercase tracking-wider text-naranja shadow-[0_-6px_28px_rgba(0,0,0,0.65)] backdrop-blur-md transition hover:bg-carbon/95 hover:text-naranja-soft lg:hidden"
>
  <Icon name="whatsapp" class="h-5 w-5" />
  WhatsApp
</a>

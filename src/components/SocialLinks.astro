---
import Icon from './Icon.astro';
import { socialLinks } from '../lib/contact';

const items = socialLinks();
---

<ul class="flex flex-wrap items-center gap-3" aria-label="Redes sociales">
  {
    items.map((item) => (
      <li>
        <a
          href={item.url}
          target="_blank"
          rel="noopener noreferrer"
          aria-label={item.label}
          title={item.pending ? '[PENDIENTE] URL de ejemplo por confirmar' : undefined}
          class="flex h-12 w-12 items-center justify-center rounded-full border border-white/15 bg-white/5 text-white/80 transition hover:border-naranja hover:bg-naranja hover:text-carbon"
        >
          <Icon name={item.icon} class="h-5 w-5" />
        </a>
      </li>
    ))
  }
</ul>

---
interface Props {
  eyebrow?: string;
  title: string;
  lead?: string;
}

const { eyebrow, title, lead } = Astro.props;
---

<section class="border-b border-white/10 bg-carbon-soft">
  <div class="mx-auto max-w-6xl px-4 py-12 sm:px-6 lg:px-8 lg:py-16">
    {eyebrow && <p class="text-xs font-semibold uppercase tracking-widest text-turquesa">{eyebrow}</p>}
    <h1 class="mt-3 text-3xl leading-tight sm:text-5xl">{title}</h1>
    {lead && <p class="mt-4 max-w-2xl text-lg leading-relaxed text-white/70">{lead}</p>}
    <slot />
  </div>
</section>

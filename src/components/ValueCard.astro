---
import Icon from './Icon.astro';

interface Props {
  index: number;
  title: string;
  text: string;
  icon?: string;
  class?: string;
}

const { index, title, text, icon, class: className = '' } = Astro.props;
---

<article
  class:list={[
    'card-glow flex h-full flex-col gap-3 rounded-3xl border border-white/10 bg-[#1c1c1c] p-5',
    className,
  ]}
>
  <span
    class="flex h-11 w-11 items-center justify-center rounded-full bg-turquesa/15 text-turquesa-soft"
  >
    {
      icon ? (
        <Icon name={icon} class="h-6 w-6" />
      ) : (
        <span class="text-xs font-bold">{String(index).padStart(2, '0')}</span>
      )
    }
  </span>
  <div class="mt-auto flex flex-col gap-2">
    <h3 class="text-lg leading-tight">{title}</h3>
    <p class="text-sm leading-relaxed text-white/60">{text}</p>
  </div>
</article>

---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import GalleryGrid from '../components/GalleryGrid.astro';
import PrimaryButton from '../components/PrimaryButton.astro';
---

<BaseLayout
  title="Galería | Oriente Gaitero"
  description="Fotografías de Oriente Gaitero en vivo, backstage, agrupación y público."
>
  <PageHero
    eyebrow="Galería"
    title="FOTOS"
    lead="En vivo, backstage, agrupación y público. Toca una imagen para verla en pantalla completa."
  />

  <section>
    <div class="mx-auto max-w-6xl px-4 py-14 sm:px-6 lg:px-8 lg:py-20">
      <GalleryGrid filterable />
      <div class="mt-10 flex flex-wrap gap-3">
        <PrimaryButton href="/contacto">Contratar</PrimaryButton>
      </div>
    </div>
  </section>
</BaseLayout>
